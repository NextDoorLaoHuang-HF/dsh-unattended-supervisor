{
  "name": "dsh-unattended-supervisor",
  "version": "0.1.0",
  "description": "Session-scoped unattended task supervision with a non-destructive switch and QQ decision mail",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "scripts",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/check.mjs && node scripts/harness-smoke.mjs && node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-commands": "^0.2.0",
    "@deepseek-ai/dsh-session": "^0.2.0",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0",
    "@deepseek-ai/dsh-tools": "^0.2.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
